{
  "name": "@lucenaone/coder",
  "version": "1.4.2",
  "description": "Private relay tunnel for connecting LucenaCoder.com to your local folder. Always remains folder scoped while providing full terminal access.",
  "type": "module",
  "bin": {
    "lucenacoder": "./bin/lucena.js"
  },
  "files": [
    "bin",
    "src",
    "grammars",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/lucena.js",
    "test:terminal": "node --test src/native-terminal-core.test.js",
    "postinstall": "node src/ensure-node-pty-ready.js",
    "prepublishOnly": "node ../../scripts/sync-alias-version.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "execa": "^9.6.1",
    "ignore": "^7.0.5",
    "node-pty": "^1.1.0",
    "shell-quote": "^1.8.4",
    "sql.js": "^1.14.1",
    "web-tree-sitter": "^0.26.9",
    "ws": "^8.20.1"
  },
  "keywords": [
    "lucena",
    "lucenacoder",
    "tunnel",
    "lucenaone"
  ],
  "author": "LucenaOne",
  "license": "MIT"
}
